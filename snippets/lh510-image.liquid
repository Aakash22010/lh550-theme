{%- comment -%}
  Image from the theme editor, or the bundled design image (exported from Figma) when none is picked.

  Accepts:
  - image: {Object} image_picker value
  - fallback: {String} asset filename used when image is blank
  - alt, class, sizes: {String}
  - loading: {String} 'lazy' (default) or 'eager' for above-the-fold images
  - width / height: {Number} intrinsic size of the fallback file (needed whenever a fallback is used)

  Usage:
  {% render 'lh510-image', image: section.settings.image, fallback: 'lh510-hero.jpg', alt: '', width: 2177, height: 882 %}
{%- endcomment -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
-%}
{%- if image != blank -%}
  {{ image | image_url: width: 2400 | image_tag: class: class, alt: alt, sizes: img_sizes, loading: img_loading, widths: '400, 600, 800, 1000, 1400, 1800, 2400' }}
{%- else -%}
  <img class="{{ class }}" src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" loading="{{ img_loading }}" width="{{ width }}" height="{{ height }}">
{%- endif -%}
