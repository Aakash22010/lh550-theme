{%- comment -%}
  Star rating from the design: filled #ffc107, empty #787878, a half star is split down the middle.

  Accepts:
  - rating: {Number} 0-5, halves allowed
  - class: {String} extra class on the wrapper

  Usage:
  {% render 'lh550-stars', rating: 4.5 %}
{%- endcomment -%}
{%- assign stars_rating = rating | default: 0 | times: 1.0 -%}
<span class="lh-stars {{ class }}" role="img" aria-label="{{ stars_rating }} out of 5 stars">
  {%- for i in (1..5) -%}
    {%- assign half_at = i | minus: 0.5 -%}
    {%- if stars_rating >= i -%}
      {%- assign star_state = 'full' -%}
    {%- elsif stars_rating >= half_at -%}
      {%- assign star_state = 'half' -%}
    {%- else -%}
      {%- assign star_state = 'empty' -%}
    {%- endif -%}
    <span class="lh-stars__star is-{{ star_state }}" aria-hidden="true">
      <svg viewBox="0 0 20 19"><path d="M10 0l2.94 6.06 6.66.92-4.85 4.65 1.18 6.62L10 15.1l-5.93 3.15 1.18-6.62L.4 6.98l6.66-.92z"/></svg>
      {%- if star_state == 'half' -%}<span class="lh-stars__fill"><svg viewBox="0 0 20 19"><path d="M10 0l2.94 6.06 6.66.92-4.85 4.65 1.18 6.62L10 15.1l-5.93 3.15 1.18-6.62L.4 6.98l6.66-.92z"/></svg></span>{%- endif -%}
    </span>
  {%- endfor -%}
</span>
