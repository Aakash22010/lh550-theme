{%- comment -%}
  Picked image, or the bundled fallback asset. Pass the fallback's width/height.
  {% render 'lh400-image', image: section.settings.image, fallback: 'lh400-hero.jpg', alt: '', width: 3000, height: 1500 %}
{%- endcomment -%}
{%- liquid
  assign img_loading = loading | default: 'lazy'
  assign img_sizes = sizes | default: '100vw'
-%}
{%- if image != blank -%}
  {{ image | image_url: width: 2400 | image_tag: class: class, alt: alt, sizes: img_sizes, loading: img_loading, widths: '400, 600, 800, 1000, 1400, 1800, 2400' }}
{%- else -%}
  <img class="{{ class }}" src="{{ fallback | asset_url }}" alt="{{ alt | escape }}" loading="{{ img_loading }}" width="{{ width }}" height="{{ height }}">
{%- endif -%}
