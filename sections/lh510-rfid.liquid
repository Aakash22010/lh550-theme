{%- comment -%}
  LH510 - RFID roles
  Figma: "multiple role RFID's for your convenience" - 3 white cards
  (433x584), title + text on top, photo at the bottom.
  One block per card (title, text, photo, photo focal point for desktop / mobile).
  Grid on desktop, swipe row on mobile.
{%- endcomment -%}
{% render 'lh510-assets' %}
{{ 'lh510-rfid.css' | asset_url | stylesheet_tag }}

<section class="lh lh-section lh-rfid" style="--pt:{{ section.settings.padding_top }};--ptm:{{ section.settings.padding_top_mobile }}">
  <div class="lh-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lh-rfid__heading">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {%- endif -%}
  </div>

  {% # Cards %}
  <div class="lh-rfid__wrap">
    <ul class="lh-rfid__cards" role="list">
      {%- for block in section.blocks -%}
        <li class="lh-rfid__card lh-rfid__card--{{ forloop.index }}" {{ block.shopify_attributes }}>
          <div class="lh-rfid__text">
            <h3 class="lh-rfid__title">{{ block.settings.title | escape | newline_to_br }}</h3>
            {%- if block.settings.text != blank -%}
              <p class="lh-rfid__body">{{ block.settings.text | escape | newline_to_br }}</p>
            {%- endif -%}
          </div>
          <div class="lh-rfid__media" style="--pos:{{ block.settings.focal_desktop }};--pos-m:{{ block.settings.focal_mobile }}">
            {%- render 'lh510-image', image: block.settings.image, fallback: block.settings.fallback, alt: block.settings.image_alt, class: 'lh-rfid__img', sizes: '(max-width: 899px) 70vw, 30vw', width: 784, height: 788 -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "LH510 RFID roles",
  "class": "lh510-rfid-section",
  "settings": [
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Multiple Role RFID’s \nFor Your Convenience", "info": "Line breaks apply on mobile only; desktop keeps the heading on one line." },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 56 }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "RFID role card",
      "limit": 6,
      "settings": [
        { "type": "textarea", "id": "title", "label": "Title", "default": "Hotel\nManager RFID" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Provides managers with full access to all authorized areas, enabling easy supervision and complete control of hotel operations." },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Hand tapping an RFID card on the LAVNA lock" },
        { "type": "text", "id": "fallback", "label": "Bundled image (used when no image is picked)", "default": "lh510-rfid-manager.png" },
        { "type": "text", "id": "focal_desktop", "label": "Image position on desktop (CSS object-position)", "default": "50% 35%" },
        { "type": "text", "id": "focal_mobile", "label": "Image position on mobile (CSS object-position)", "default": "50% 0%" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH510 RFID roles",
      "blocks": [
        { "type": "role", "settings": { "title": "Hotel\nManager RFID", "text": "Provides managers with full access to all authorized areas, enabling easy supervision and complete control of hotel operations.", "image_alt": "Manager tapping an RFID card on the LAVNA lock", "fallback": "lh510-rfid-manager.png", "focal_desktop": "50% 35%", "focal_mobile": "50% 0%" } },
        { "type": "role", "settings": { "title": "Guest\nSmart RFID", "text": "Offers guests secure and convenient access to their assigned rooms and permitted amenities throughout \ntheir stay.", "image_alt": "Guest tapping a smart RFID card on the LAVNA lock", "fallback": "lh510-rfid-guest.png", "focal_desktop": "50% 35%", "focal_mobile": "50% 0%" } },
        { "type": "role", "settings": { "title": "House\nKeeping RFID", "text": "Allows housekeeping staff controlled entry to guest rooms and designated service areas during scheduled hours, ensuring efficient and timely maintenance.", "image_alt": "Housekeeping staff tapping an RFID card on the LAVNA lock", "fallback": "lh510-rfid-housekeeping.png", "focal_desktop": "50% 35%", "focal_mobile": "50% 0%" } }
      ]
    }
  ]
}
{% endschema %}
