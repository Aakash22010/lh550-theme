{%- comment -%} LH400 products slider. Pick a product per block or fill the card in by hand {%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-products.css' | asset_url | stylesheet_tag }}

{%- assign view_all_url = section.settings.view_all_url | default: routes.all_products_collection_url -%}
<section class="lh lh-section lh-products" style="--pt:{{ section.settings.padding_top | default: 48 }};--ptm:{{ section.settings.padding_top_mobile | default: 32 }}"
  data-lh-slider{% if section.settings.autoplay %} data-lh-autoplay="{{ section.settings.autoplay_seconds | times: 1000 }}"{% endif %}>
  {% # heading + View All %}
  <div class="lh-container lh-products__head">
    <h2 class="lh-products__title">{{ section.settings.title | default: 'Your Smart Security Starts Here' | escape }}</h2>
    <div class="lh-products__side">
      {%- if section.settings.view_all_label != blank -%}
        <a class="lh-btn lh-btn--outline lh-products__all" href="{{ view_all_url }}">{{ section.settings.view_all_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>

  {% # cards %}
  <ul class="lh-scroller lh-scroller--free lh-products__track" data-lh-track role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        # title, link and image fall back to the picked product
        assign p = block.settings.product
        assign title = block.settings.title
        assign url = block.settings.url
        if p != blank
          if title == blank
            assign title = p.title
          endif
          if url == blank
            assign url = p.url
          endif
        endif
        if url == blank
          assign url = '#'
        endif
        assign img = block.settings.image
        if img == blank and p != blank
          assign img = p.featured_image
        endif
      -%}
      <li class="lh-products__card" {{ block.shopify_attributes }}>
        <a class="lh-products__tile" href="{{ url }}" tabindex="-1" aria-hidden="true">
          {%- render 'lh400-image', image: img, fallback: block.settings.fallback, alt: title, class: 'lh-products__img', sizes: '(max-width: 899px) 70vw, 284px', width: 600, height: 600 -%}
        </a>
        <div class="lh-products__body">
          <h3 class="lh-products__name">{{ title | escape }}</h3>
          <a class="lh-btn lh-btn--outline lh-products__btn" href="{{ url }}">{{ block.settings.button_label | default: 'Show Details' | escape }}</a>
        </div>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "LH400 products",
  "tag": "div",
  "class": "lh400-products-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Your Smart Security Starts Here" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All", "info": "Shown on desktop. Leave empty to hide." },
    { "type": "url", "id": "view_all_url", "label": "View all link", "info": "Defaults to all products." },
    { "type": "checkbox", "id": "autoplay", "label": "Auto-advance", "default": true },
    { "type": "range", "id": "autoplay_seconds", "label": "Seconds per slide", "min": 2, "max": 10, "step": 1, "default": 4 },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 32 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. Fills the title, image and link below when they are empty." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "url", "id": "url", "label": "Link", "info": "Defaults to the picked product page." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Show Details" },
        { "type": "text", "id": "fallback", "label": "Bundled image (asset file)", "default": "lh400-product-padlock.png", "info": "Used when no image or product is set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH400 products",
      "blocks": [
        { "type": "product", "settings": { "title": "LAVNA Digital Padlock LP45", "fallback": "lh400-product-padlock.png" } },
        { "type": "product", "settings": { "title": "LAVNA Digital Cabinet Lock LS10 Black", "fallback": "lh400-product-ls10.png" } },
        { "type": "product", "settings": { "title": "LAVNA Smart Safe Locker 58L", "fallback": "lh400-product-safe.png" } },
        { "type": "product", "settings": { "title": "LAVNA Digital Smart Gateway", "fallback": "lh400-product-gateway.png" } },
        { "type": "product", "settings": { "title": "LAVNA Smart Lift Controller", "fallback": "lh400-product-lift.png" } },
        { "type": "product", "settings": { "title": "LAVNA Digital Cabinet Lock LS11 Black", "fallback": "lh400-product-ls11.png" } }
      ]
    }
  ]
}
{% endschema %}
