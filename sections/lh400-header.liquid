{%- comment -%} LH400 header. On mobile the menu goes into the drawer (data-lh-menu in lh400.js) {%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-header.css' | asset_url | stylesheet_tag }}

{%- assign menu = section.settings.menu -%}
<header class="lh lh-header" data-lh-menu>
  <div class="lh-header__bar">
    <a class="lh-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | default: 'LAVNA' | escape }}">
      {%- render 'lh400-image', image: section.settings.logo, fallback: 'lh400-logo.png', alt: 'LAVNA', class: 'lh-header__logo-img', loading: 'eager', width: 500, height: 200 -%}
    </a>

    {% # desktop menu %}
    <nav class="lh-header__nav" aria-label="Main">
      <ul class="lh-header__menu">
        {%- if menu.links.size > 0 -%}
          {%- for link in menu.links -%}
            <li class="lh-header__item{% if link.links.size > 0 %} has-children{% endif %}">
              <a class="lh-header__link" href="{{ link.url }}"{% if link.active %} aria-current="page"{% endif %}>
                {{ link.title | escape }}
                {%- if link.links.size > 0 -%}
                  <svg class="lh-header__chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {%- endif -%}
              </a>
              {%- if link.links.size > 0 -%}
                <ul class="lh-header__dropdown">
                  {%- for child in link.links -%}
                    <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        {%- else -%}
          <li class="lh-header__item"><a class="lh-header__link" href="{{ routes.root_url }}">Home</a></li>
          <li class="lh-header__item"><a class="lh-header__link" href="/pages/about-us">About Us</a></li>
          <li class="lh-header__item has-children">
            <a class="lh-header__link" href="/collections/all">
              Products
              <svg class="lh-header__chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 6l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <ul class="lh-header__dropdown">
              <li><a href="/products/lh400-hotel-smart-lock">LH400 Hotel Smart Lock</a></li>
              <li><a href="/products/lh500-hotel-smart-lock">LH500 Hotel Smart Lock</a></li>
              <li><a href="/products/lh510-hotel-smart-lock">LH510 Hotel Smart Lock</a></li>
              <li><a href="/products/lh550-hotel-smart-lock">LH550 Hotel Smart Lock</a></li>
            </ul>
          </li>
          <li class="lh-header__item"><a class="lh-header__link" href="/pages/contact">Contact Us</a></li>
          <li class="lh-header__item"><a class="lh-header__link" href="/blogs/news">Blog</a></li>
          <li class="lh-header__item"><a class="lh-header__link" href="/pages/collaboration">Collaboration</a></li>
        {%- endif -%}
      </ul>
    </nav>

    {% # icons + burger %}
    <div class="lh-header__icons">
      <a class="lh-header__icon" href="{{ routes.search_url }}" aria-label="Search">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.3" cy="8.3" r="6.9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M13.4 13.4l5.4 5.4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </a>
      <a class="lh-header__icon lh-header__cart" href="{{ routes.cart_url }}" aria-label="Cart">
        {% # lh400.js updates the count %}
        <span class="lh-header__count" data-lh-cart-count{% if cart.item_count == 0 %} hidden{% endif %}>{{ cart.item_count }}</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.5 1.9h9a2.5 2.5 0 0 1 2.5 2.4l.4 10.1a3.2 3.2 0 0 1-3.2 3.3H4.8a3.2 3.2 0 0 1-3.2-3.3L2 4.3a2.5 2.5 0 0 1 2.5-2.4h1z" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6.4 5.6a3.6 3.6 0 0 0 7.2 0" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
      </a>
      <a class="lh-header__icon" href="{{ routes.account_url }}" aria-label="Account">
        <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="9.3" fill="none" stroke="currentColor" stroke-width="1.3"/><circle cx="10" cy="7.5" r="3.6" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M4.2 16.6a6 6 0 0 1 11.6 0" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
      </a>
      <button class="lh-header__icon lh-header__toggle" type="button" data-lh-menu-toggle aria-expanded="false" aria-controls="lh-drawer-{{ section.id }}" aria-label="Menu">
        <svg class="lh-header__burger" viewBox="0 0 22 22" aria-hidden="true"><path d="M1 4h20M1 11h20M1 18h20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        <svg class="lh-header__close" viewBox="0 0 22 22" aria-hidden="true"><path d="M4 4l14 14M18 4L4 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>

  {% # mobile drawer %}
  <nav class="lh-header__drawer" id="lh-drawer-{{ section.id }}" aria-label="Mobile">
    <ul>
      {%- if menu.links.size > 0 -%}
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title | escape }}</a>
            {%- if link.links.size > 0 -%}
              <ul>
                {%- for child in link.links -%}
                  <li><a href="{{ child.url }}">{{ child.title | escape }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="/pages/about-us">About Us</a></li>
        <li>
          <a href="/collections/all">Products</a>
          <ul>
            <li><a href="/products/lh400-hotel-smart-lock">LH400 Hotel Smart Lock</a></li>
            <li><a href="/products/lh500-hotel-smart-lock">LH500 Hotel Smart Lock</a></li>
            <li><a href="/products/lh510-hotel-smart-lock">LH510 Hotel Smart Lock</a></li>
            <li><a href="/products/lh550-hotel-smart-lock">LH550 Hotel Smart Lock</a></li>
          </ul>
        </li>
        <li><a href="/pages/contact">Contact Us</a></li>
        <li><a href="/blogs/news">Blog</a></li>
        <li><a href="/pages/collaboration">Collaboration</a></li>
      {%- endif -%}
    </ul>
  </nav>
</header>

{% schema %}
{
  "name": "LH400 header",
  "tag": "div",
  "class": "lh400-header-section",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to use the LAVNA logo from the design." },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu", "info": "Items with child links open a dropdown (like Products in the design). Leave empty for the design's menu." }
  ],
  "presets": [{ "name": "LH400 header" }]
}
{% endschema %}
