{%- comment -%} LH500 applications: door card on the left, two rows of cards on the right {%- endcomment -%}
{% render 'lh500-assets' %}
{{ 'lh500-applications.css' | asset_url | stylesheet_tag }}

<section class="lh lh-section lh-apps" style="--pt:{{ section.settings.padding_top }};--ptm:{{ section.settings.padding_top_mobile }}">
  <div class="lh-container lh-apps__container">
    <h2 class="lh-apps__title">{{ section.settings.title | escape }}</h2>

    <div class="lh-apps__door">
      {%- render 'lh500-image',
        image: section.settings.door_image,
        fallback: 'lh500-app-door.png',
        alt: section.settings.door_alt,
        class: 'lh-apps__door-img',
        sizes: '(max-width: 899px) 46vw, 427px',
        width: 534,
        height: 834
      -%}
    </div>

    <div class="lh-apps__cards-wrap">
      <ul class="lh-apps__track" role="list">
        {%- assign total = section.blocks.size -%}
        {%- assign half = total | divided_by: 2.0 | ceil -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign title = block.settings.title
            assign fw = 756
            assign fh = 574
            if block.settings.fallback contains 'hospital' or block.settings.fallback contains 'gym'
              assign fh = 586
            endif

            assign row_class = 'lh-apps__card--row-1'
            assign col_idx = forloop.index
            if forloop.index > half
              assign row_class = 'lh-apps__card--row-2'
              assign col_idx = forloop.index | minus: half
            endif
          -%}
          <li class="lh-apps__card {{ row_class }}" style="--col:{{ col_idx }}" {{ block.shopify_attributes }}>
            <div class="lh-apps__card-content">
              {%- if block.settings.image != blank or block.settings.fallback != blank -%}
                {%- render 'lh500-image',
                  image: block.settings.image,
                  fallback: block.settings.fallback,
                  alt: title,
                  class: 'lh-apps__img',
                  sizes: '(max-width: 899px) 39vw, 312px',
                  width: fw,
                  height: fh
                -%}
              {%- endif -%}
              {%- if block.settings.image != blank and title != blank -%}
                <h3 class="lh-apps__name">{{ title | escape }}</h3>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LH500 applications",
  "tag": "div",
  "class": "lh500-applications-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Explore More Applications for Hotel Locks" },
    { "type": "image_picker", "id": "door_image", "label": "Door lock image", "info": "Leave empty for the design's door lock card." },
    { "type": "text", "id": "door_alt", "label": "Door lock alt text", "default": "LAVNA smart hotel lock on wooden door" },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 32 }
  ],
  "blocks": [
    {
      "type": "app",
      "name": "Application",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image (asset file)", "info": "Used when no image is set." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH500 applications",
      "blocks": [
        { "type": "app", "settings": { "title": "PG's", "fallback": "lh500-app-pg.png" } },
        { "type": "app", "settings": { "title": "Hospital Inventory Area", "fallback": "lh500-app-hospital.png" } },
        { "type": "app", "settings": { "title": "Document Room", "fallback": "lh500-app-document-room.png" } },
        { "type": "app", "settings": { "title": "Gym Private Area", "fallback": "lh500-app-gym.png" } },
        { "type": "app", "settings": { "title": "Bank Locker Room", "fallback": "lh500-app-bank-locker.png" } },
        { "type": "app", "settings": { "title": "Private Cabin Area", "fallback": "lh500-app-cabin.png" } }
      ]
    }
  ]
}
{% endschema %}
