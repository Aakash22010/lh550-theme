{%- comment -%}
  LH400 compatible extensions, one block per card.
  With a product picked the button adds it to the cart, otherwise it links to button_link.
{%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-extensions.css' | asset_url | stylesheet_tag }}

<section class="lh lh-section lh-extensions" style="--pt:{{ section.settings.padding_top | default: 48 }};--ptm:{{ section.settings.padding_top_mobile | default: 32 }}">
  <div class="lh-container">
    <h2 class="lh-extensions__title">{{ section.settings.title | default: 'Compatible Extensions For Hotel Locks & Management' | escape }}</h2>
  </div>

  <ul class="lh-scroller lh-scroller--free lh-extensions__track" role="list">
    {%- for block in section.blocks -%}
      {%- liquid
        assign p = block.settings.product
        assign title = block.settings.title
        if p != blank and title == blank
          assign title = p.title
        endif
        assign img = block.settings.image
        if img == blank and p != blank
          assign img = p.featured_image
        endif
        assign action = block.settings.button_action | default: 'add'
      -%}
      <li class="lh-extensions__card" {{ block.shopify_attributes }}>
        <div class="lh-extensions__tile">
          {%- render 'lh400-image', image: img, fallback: block.settings.fallback, alt: title, class: 'lh-extensions__img', width: 800, height: 800 -%}
        </div>
        <h3 class="lh-extensions__name">{{ title | escape }}</h3>
        {%- if p != blank -%}
          {%- capture btn_content -%}<span>{{ block.settings.button_label | default: 'Add to Cart' | escape }}</span>{%- endcapture -%}
          {% render 'lh400-buy-button', product: p, action: action, class: 'lh-btn lh-btn--primary lh-btn--sweep lh-extensions__btn', content: btn_content, aria_label: title %}
        {%- else -%}
          <a class="lh-btn lh-btn--primary lh-btn--sweep lh-extensions__btn" href="{{ block.settings.button_link | default: '/collections/all' }}"><span>{{ block.settings.button_label | default: 'Add to Cart' | escape }}</span></a>
        {%- endif -%}
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "LH400 extensions",
  "tag": "div",
  "class": "lh400-extensions-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Compatible Extensions For Hotel Locks & Management" },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 48 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 32 }
  ],
  "blocks": [
    {
      "type": "extension",
      "name": "Extension",
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "Optional. Fills an empty title and powers the button. Without a product the button links below." },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image (asset file)", "info": "Used when no image or product is set." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to Cart" },
        {
          "type": "select",
          "id": "button_action",
          "label": "Button action (needs a product)",
          "options": [
            { "value": "add", "label": "Add to cart" },
            { "value": "buy", "label": "Buy now" }
          ],
          "default": "add"
        },
        { "type": "url", "id": "button_link", "label": "Button link (no product)", "info": "Defaults to all products." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH400 extensions",
      "blocks": [
        { "type": "extension", "settings": { "title": "LAVNA Smart RFID Cards (Pack of 5)", "fallback": "lh400-ext-rfid-cards.png", "button_label": "Add to Cart", "button_action": "add" } },
        { "type": "extension", "settings": { "title": "LAVNA Smart Energy Saver", "fallback": "lh400-ext-energy-saver.png", "button_label": "Add to Cart", "button_action": "add" } },
        { "type": "extension", "settings": { "title": "LAVNA Digital Smart Encoder", "fallback": "lh400-ext-encoder.png", "button_label": "Add to Cart", "button_action": "add" } },
        { "type": "extension", "settings": { "title": "LAVNA Smart Lift Controller", "fallback": "lh400-ext-lift-controller.png", "button_label": "Add to Cart", "button_action": "buy" } },
        { "type": "extension", "settings": { "title": "LAVNA Digital Smart Gateway", "fallback": "lh400-ext-gateway.png", "button_label": "Add to Cart", "button_action": "buy" } }
      ]
    }
  ]
}
{% endschema %}
