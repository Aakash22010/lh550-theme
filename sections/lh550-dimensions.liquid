{%- comment -%}
  LH550 - Lock dimensions.
  Heading, three annotated diagrams (front panel, mortise, back panel) split by blue rules,
  a footnote under the mortise, and the mortise durability banner below.
  The measurement blocks are read out to screen readers; the diagrams show them visually.
  Diagrams are bundled (assets/lh550-dim-*-annotated.png); the pickers override them.
{%- endcomment -%}
{% render 'lh550-assets' %}
{{ 'lh550-dimensions.css' | asset_url | stylesheet_tag }}

<section class="lh lh-section lh-dimensions" style="--pt:{{ section.settings.padding_top }};--ptm:{{ section.settings.padding_top_mobile }}">
  <div class="lh-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="lh-dimensions__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    {% # Annotated diagrams (measurements + callouts are drawn in), blue rules either side of the mortise %}
    <div class="lh-dimensions__grid">
      <div class="lh-dimensions__figure lh-dimensions__figure--front">
        {%- render 'lh550-image', image: section.settings.front_image, fallback: 'lh550-dim-front-annotated.png', alt: section.settings.front_alt, class: 'lh-dimensions__img', sizes: '(max-width: 899px) 60vw, 240px', width: 289, height: 424 -%}
      </div>
      <div class="lh-dimensions__figure lh-dimensions__figure--mortise">
        {%- render 'lh550-image', image: section.settings.mortise_image, fallback: 'lh550-dim-mortise-annotated.png', alt: section.settings.mortise_alt, class: 'lh-dimensions__img', sizes: '(max-width: 899px) 76vw, 310px', width: 385, height: 354 -%}
        {%- if section.settings.footnote != blank -%}
          <p class="lh-dimensions__footnote">{{ section.settings.footnote | escape }}</p>
        {%- endif -%}
      </div>
      <div class="lh-dimensions__figure lh-dimensions__figure--back">
        {%- render 'lh550-image', image: section.settings.back_image, fallback: 'lh550-dim-back-annotated.png', alt: section.settings.back_alt, class: 'lh-dimensions__img', sizes: '(max-width: 899px) 68vw, 280px', width: 340, height: 434 -%}
      </div>
    </div>

    {% # Measurements as text for screen readers - the diagrams carry them visually %}
    {%- if section.blocks.size > 0 -%}
      <dl class="lh-dimensions__legend">
        {%- for block in section.blocks -%}
          <div class="lh-dimensions__item" {{ block.shopify_attributes }}>
            <dt>{{ block.settings.label | escape }}</dt>
            {%- if block.settings.value != blank -%}
              <dd>{{ block.settings.value | escape }}</dd>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    <figure class="lh-dimensions__banner">
      {%- render 'lh550-image', image: section.settings.banner_image, fallback: 'lh550-dim-durability.png', alt: section.settings.banner_alt, class: 'lh-dimensions__banner-img lh-dimensions__banner-img--d', sizes: '(max-width: 899px) 1px, 94vw', width: 4096, height: 2043 -%}
      {%- render 'lh550-image', image: section.settings.banner_image_mobile, fallback: 'lh550-dim-durability-mobile.jpg', alt: section.settings.banner_alt, class: 'lh-dimensions__banner-img lh-dimensions__banner-img--m', sizes: '(max-width: 899px) 90vw, 1px', width: 452, height: 735 -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "LH550 dimensions",
  "tag": "div",
  "class": "lh550-dimensions-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "LH550 Lock Dimensions" },
    { "type": "header", "content": "Diagrams", "info": "Leave a picker empty to use the annotated diagram from the design. Uploads should include their measurements and labels." },
    { "type": "image_picker", "id": "front_image", "label": "Front panel diagram" },
    { "type": "text", "id": "front_alt", "label": "Front panel alt text", "default": "LH550 front panel dimensions" },
    { "type": "image_picker", "id": "mortise_image", "label": "Mortise diagram" },
    { "type": "text", "id": "mortise_alt", "label": "Mortise alt text", "default": "LH550 mortise dimensions" },
    { "type": "image_picker", "id": "back_image", "label": "Back panel diagram" },
    { "type": "text", "id": "back_alt", "label": "Back panel alt text", "default": "LH550 back panel dimensions" },
    { "type": "header", "content": "Footnote" },
    { "type": "text", "id": "footnote", "label": "Footnote", "default": "Fits on 38-65mm thick wooden doors, ideal for main door" },
    { "type": "header", "content": "Durability banner" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image", "info": "Leave empty to use the mortise durability banner from the design." },
    { "type": "image_picker", "id": "banner_image_mobile", "label": "Banner image (mobile)", "info": "Portrait version for phones. Leave empty to use the design's mobile banner." },
    { "type": "text", "id": "banner_alt", "label": "Banner alt text", "default": "LA760 mortise durability test" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "label": "Top spacing (desktop)", "min": 0, "max": 200, "step": 2, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_top_mobile", "label": "Top spacing (mobile)", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 56 }
  ],
  "blocks": [
    {
      "type": "note",
      "name": "Measurement",
      "limit": 12,
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Panel height" },
        { "type": "text", "id": "value", "label": "Value", "default": "30 cm", "info": "Read out to screen readers; the diagrams show the measurements." }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH550 dimensions",
      "blocks": [
        { "type": "note", "settings": { "label": "Panel height", "value": "30 cm" } },
        { "type": "note", "settings": { "label": "Panel width", "value": "7.6 cm" } },
        { "type": "note", "settings": { "label": "Panel base", "value": "5.5 cm" } },
        { "type": "note", "settings": { "label": "Handle length", "value": "15 cm" } },
        { "type": "note", "settings": { "label": "Mortise height", "value": "24 cm" } },
        { "type": "note", "settings": { "label": "Mortise face", "value": "2.25 cm" } },
        { "type": "note", "settings": { "label": "Bolt throw", "value": "7 cm" } },
        { "type": "note", "settings": { "label": "RFID Card scanner", "value": "" } },
        { "type": "note", "settings": { "label": "Manual key area", "value": "" } },
        { "type": "note", "settings": { "label": "Battery area", "value": "" } },
        { "type": "note", "settings": { "label": "DND knob", "value": "" } },
        { "type": "note", "settings": { "label": "304 ultra strong steel bolt", "value": "" } }
      ]
    }
  ]
}
{% endschema %}
