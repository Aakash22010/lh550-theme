{%- comment -%} LH400 energy saver: pro vs lite, door designs, software banner {%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-energy.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="lh lh-section lh-energy" style="--pt:{{ s.padding_top }};--ptm:{{ s.padding_top_mobile }}">
  <div class="lh-container">

    {% # pro vs lite %}
    <div class="lh-energy__compare">
      <div class="lh-energy__banner">
        {%- render 'lh400-image', image: s.compare_image, fallback: 'lh400-energy-compare.png', alt: s.compare_alt, class: 'lh-energy__banner-img', sizes: '(min-width: 1440px) 1344px, 94vw', width: 3000, height: 800 -%}
      </div>
      <div class="lh-energy__body">
        <h2 class="lh-energy__label">{{ s.features_heading | default: 'KEY FEATURES' | escape }}</h2>
        <div class="lh-energy__captions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              {%- liquid
                assign def_fb = 'lh400-esaver-pro.png'
                if forloop.index == 2
                  assign def_fb = 'lh400-esaver-lite.png'
                endif
                assign fb = block.settings.fallback | default: def_fb
                assign lines = block.settings.text | newline_to_br | split: '<br />'
              -%}
              <div class="lh-energy__caption" {{ block.shopify_attributes }}>
                <div class="lh-energy__card-tile">
                  {%- render 'lh400-image', image: block.settings.mobile_image, fallback: fb, alt: block.settings.title, class: 'lh-energy__tile-img', width: 800, height: 600 -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <h3 class="lh-energy__caption-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <ul class="lh-energy__bullets" role="list">
                  {%- for line in lines -%}
                    {%- assign clean_line = line | strip -%}
                    {%- if clean_line != blank -%}
                      <li class="lh-energy__bullet">{{ clean_line }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {% # door designs %}
    <div class="lh-energy__beauty">
      <div class="lh-energy__doors-grid">
        <div class="lh-energy__door-col lh-energy__door-col--left">
          <div class="lh-energy__door-item lh-energy__door-item--1">
            {%- render 'lh400-image', fallback: 'lh400-door-1.png', alt: 'Lavna LH400 on fluted oak door with bronze trim', class: 'lh-energy__door-img lh-energy__door-img--desktop', width: 550, height: 365 -%}
            {%- render 'lh400-image', fallback: 'lh400-door-1-mobile.png', alt: 'Lavna LH400 on fluted oak door with bronze trim', class: 'lh-energy__door-img lh-energy__door-img--mobile', width: 354, height: 450 -%}
          </div>
          <div class="lh-energy__door-item lh-energy__door-item--2">
            {%- render 'lh400-image', fallback: 'lh400-door-2.png', alt: 'Lavna LH400 on light oak door', class: 'lh-energy__door-img lh-energy__door-img--desktop', width: 550, height: 275 -%}
            {%- render 'lh400-image', fallback: 'lh400-door-2-mobile.png', alt: 'Lavna LH400 on fluted oak door', class: 'lh-energy__door-img lh-energy__door-img--mobile', width: 536, height: 305 -%}
          </div>
        </div>

        <div class="lh-energy__door-col lh-energy__door-center">
          <div class="lh-energy__door-item lh-energy__door-item--3">
            {%- render 'lh400-image', fallback: 'lh400-door-3.png', alt: 'Lavna LH400 on paneled oak door', class: 'lh-energy__door-img lh-energy__door-img--desktop', width: 550, height: 460 -%}
            {%- render 'lh400-image', fallback: 'lh400-door-3-mobile.png', alt: 'Lavna LH400 on paneled oak door', class: 'lh-energy__door-img lh-energy__door-img--mobile', width: 355, height: 297 -%}
          </div>
          <div class="lh-energy__door-card">
            <h2 class="lh-energy__door-title">
              <span class="lh-line">LOOKS <span class="lh-highlight">BEAUTIFUL</span> ON</span>
              <span class="lh-line"><span class="lh-highlight">EVERY DOOR</span> DESIGN</span>
            </h2>
          </div>
        </div>

        <div class="lh-energy__door-col lh-energy__door-col--right">
          <div class="lh-energy__door-item lh-energy__door-item--4">
            {%- render 'lh400-image', fallback: 'lh400-door-4.png', alt: 'Lavna LH400 with hotel room view', class: 'lh-energy__door-img lh-energy__door-img--desktop', width: 550, height: 311 -%}
            {%- render 'lh400-image', fallback: 'lh400-door-4-mobile.png', alt: 'Lavna LH400 with hotel room view', class: 'lh-energy__door-img lh-energy__door-img--mobile', width: 536, height: 305 -%}
          </div>
          <div class="lh-energy__door-item lh-energy__door-item--5">
            {%- render 'lh400-image', fallback: 'lh400-door-5.png', alt: 'Lavna LH400 inside view on oak door', class: 'lh-energy__door-img lh-energy__door-img--desktop', width: 550, height: 328 -%}
            {%- render 'lh400-image', fallback: 'lh400-door-5-mobile.png', alt: 'Lavna LH400 inside view on oak door', class: 'lh-energy__door-img lh-energy__door-img--mobile', width: 355, height: 451 -%}
          </div>
        </div>
      </div>
    </div>

    {% # software banner %}
    <div class="lh-energy__software">
      {%- render 'lh400-image', image: s.software_image, fallback: 'lh400-energy-software.png', alt: s.software_alt, class: 'lh-energy__software-img lh-energy__software-img--desktop', sizes: '(min-width: 900px) 1344px', width: 3000, height: 1500 -%}
      {%- render 'lh400-image', image: s.software_image_mobile, fallback: 'lh400-energy-software-mobile.png', alt: s.software_alt, class: 'lh-energy__software-img lh-energy__software-img--mobile', sizes: '(max-width: 899px) 94vw', width: 722, height: 1084 -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "LH400 energy",
  "tag": "div",
  "class": "lh400-energy-section",
  "settings": [
    {
      "type": "header",
      "content": "Energy saver (pro vs lite)"
    },
    {
      "type": "image_picker",
      "id": "compare_image",
      "label": "Pro vs lite banner",
      "info": "About 1342:358. Leave empty to use the pro-vs-lite banner from the design."
    },
    {
      "type": "text",
      "id": "compare_alt",
      "label": "Banner alt text",
      "default": "Hotel energy saver pro versus lite comparison"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features label",
      "default": "KEY FEATURES"
    },
    {
      "type": "header",
      "content": "Software banner"
    },
    {
      "type": "image_picker",
      "id": "software_image",
      "label": "Software banner",
      "info": "About 2:1. Leave empty to use the lock software banner from the design."
    },
    {
      "type": "image_picker",
      "id": "software_image_mobile",
      "label": "Software banner (mobile)",
      "info": "About 2:3. Leave empty to use the mobile software banner from the design."
    },
    {
      "type": "text",
      "id": "software_alt",
      "label": "Software banner alt text",
      "default": "LAVNA hotel lock management software"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caption",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Caption title (optional)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile card image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Fallback image asset (e.g. lh400-esaver-pro.png)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Caption text",
          "default": "Caption text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH400 energy",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "A valid RFID or key card is inserted.\nPower consumption recorded in Software.\nBrief Power delay after card removal"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Any RFID Card can be inserted.\nSave Electricity when card not placed.\nInstant Power off after card removal"
          }
        }
      ]
    }
  ]
}
{% endschema %}
