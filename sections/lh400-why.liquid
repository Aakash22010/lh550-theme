{%- comment -%} LH400 Why LAVNA. One block per reason, the colours alternate {%- endcomment -%}
{% render 'lh400-assets' %}
{{ 'lh400-why.css' | asset_url | stylesheet_tag }}

<section class="lh lh-section lh-why"
  style="--pt:{{ section.settings.padding_top }};--ptm:{{ section.settings.padding_top_mobile }};--why-a:{{ section.settings.color_blue }};--why-b:{{ section.settings.color_peach }};--n:{{ section.blocks.size }}">
  <div class="lh-container">
    <h2 class="lh-why__title"><span>{{ section.settings.title | escape }}</span></h2>
  </div>

  <ol class="lh-why__cards" role="list">
    {%- for block in section.blocks -%}
      <li class="lh-why__card" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <div class="lh-why__body">
          <span class="lh-why__icon-box">
            {%- render 'lh400-image', image: block.settings.icon, fallback: block.settings.fallback, alt: block.settings.icon_alt, class: 'lh-why__icon', sizes: '64px', width: 76, height: 69 -%}
          </span>
          <p class="lh-why__text">{{ block.settings.text | escape }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>

<script>
  (function () {
    /* the cards slide in the first time the stack is on screen */
    function setup(root) {
      if (!root || root.getAttribute('data-lh-ready')) return;
      root.setAttribute('data-lh-ready', '1');
      var stack = root.querySelector('.lh-why__cards');
      var desktop = window.matchMedia('(min-width: 900px)').matches;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!stack || !desktop || reduce || !('IntersectionObserver' in window)) return;
      root.classList.add('is-armed');
      var io = new IntersectionObserver(function (entries) {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        root.classList.add('is-in');
      }, { threshold: 0.35 });
      io.observe(stack);
    }

    function boot() {
      var list = document.querySelectorAll('.lh-why');
      for (var i = 0; i < list.length; i++) setup(list[i]);
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
    else boot();
    document.addEventListener('shopify:section:load', boot);
  })();
</script>

{% schema %}
{
  "name": "LH400 why",
  "class": "lh400-why-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why LAVNA?" },
    { "type": "color", "id": "color_blue", "label": "Card colour 1", "default": "#afd7f0" },
    { "type": "color", "id": "color_peach", "label": "Card colour 2", "default": "#f4c2b1" },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 78 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 48 }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Reason" },
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "fallback", "label": "Bundled icon (asset file)", "default": "lh400-why-best.png", "info": "Used when no icon is picked." },
        { "type": "text", "id": "icon_alt", "label": "Icon alt text", "default": "Reason icon" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH400 why",
      "blocks": [
        { "type": "reason", "settings": { "text": "India’s Only Niche Brand in the Smart Lock Industry", "fallback": "lh400-why-best.png", "icon_alt": "Award badge icon" } },
        { "type": "reason", "settings": { "text": "Fastest Delivery Across India, Right to Your Doorstep", "fallback": "lh400-why-fast.png", "icon_alt": "Fast delivery icon" } },
        { "type": "reason", "settings": { "text": "Trusted by Over 1.5 Million Satisfied Customers", "fallback": "lh400-why-like.png", "icon_alt": "Thumbs up icon" } },
        { "type": "reason", "settings": { "text": "Installation & Support Across 25+ Cities", "fallback": "lh400-why-tools.png", "icon_alt": "Installation tools icon" } }
      ]
    }
  ]
}
{% endschema %}
