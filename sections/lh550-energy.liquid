{%- comment -%}
  LH550 - Energy
  Figma: "Hotel door lh550" desktop - the pro-vs-lite energy saver band
  (banner + KEY FEATURES + two captions in a bordered card), the
  "Looks BEAUTIFUL on every door design" media+text band, and the
  full-width hotel lock software banner.
  Blocks: "feature" (band 1 caption title + text) and "shot" (band 1
  photo row). The 4 detail photos have no Figma exports yet, so shot
  blocks are image_pickers with no fallback and render only when set.
{%- endcomment -%}
{% render 'lh550-assets' %}
{{ 'lh550-energy.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}
<section class="lh lh-section lh-energy" style="--pt:{{ s.padding_top }};--ptm:{{ s.padding_top_mobile }}">
  <div class="lh-container">

    {% # Band 1 - pro vs lite card %}
    <div class="lh-energy__compare">
      <div class="lh-energy__banner">
        {%- render 'lh550-image', image: s.compare_image, fallback: 'lh550-energy-compare.png', alt: s.compare_alt, class: 'lh-energy__banner-img', sizes: '(min-width: 1440px) 1344px, 94vw', width: 3000, height: 800 -%}
      </div>
      <div class="lh-energy__body">
        <h2 class="lh-energy__label">{{ s.features_heading | default: 'KEY FEATURES' | escape }}</h2>
        <div class="lh-energy__captions">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
              {%- liquid
                assign def_fb = 'lh550-esaver-pro.png'
                if forloop.index == 2
                  assign def_fb = 'lh550-esaver-lite.png'
                endif
                assign fb = block.settings.fallback | default: def_fb
                assign lines = block.settings.text | newline_to_br | split: '<br />'
              -%}
              <div class="lh-energy__caption" {{ block.shopify_attributes }}>
                <div class="lh-energy__card-tile">
                  {%- render 'lh550-image', image: block.settings.mobile_image, fallback: fb, alt: block.settings.title, class: 'lh-energy__tile-img', width: 800, height: 600 -%}
                </div>
                {%- if block.settings.title != blank -%}
                  <h3 class="lh-energy__caption-title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                <ul class="lh-energy__bullets" role="list">
                  {%- for line in lines -%}
                    {%- assign clean_line = line | strip -%}
                    {%- if clean_line != blank -%}
                      <li class="lh-energy__bullet">{{ clean_line }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>


    {% # Band 1 - detail photo row (renders only for shots with an image picked) %}
    {%- assign has_shots = false -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'shot' and block.settings.image != blank -%}
        {%- assign has_shots = true -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if has_shots -%}
      <div class="lh-energy__shots">
        {%- for block in section.blocks -%}
          {%- if block.type == 'shot' and block.settings.image != blank -%}
            <figure class="lh-energy__shot" {{ block.shopify_attributes }}>
              {{ block.settings.image | image_url: width: 800 | image_tag: class: 'lh-energy__shot-img', alt: block.settings.alt, loading: 'lazy', widths: '400, 600, 800' }}
            </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {% # Band 2 - 5-door collage with center message card %}
    <div class="lh-energy__beauty">
      <div class="lh-energy__doors-grid">
        <div class="lh-energy__door-col lh-energy__door-col--left">
          <div class="lh-energy__door-item lh-energy__door-item--1">
            {%- render 'lh550-image', image: s.door_1_image, fallback: 'lh550-door-1.png', alt: 'Lavna LH550 on fluted door with vertical bronze trim', class: 'lh-energy__door-img', width: 550, height: 365 -%}
          </div>
          <div class="lh-energy__door-item lh-energy__door-item--2">
            {%- render 'lh550-image', image: s.door_2_image, fallback: 'lh550-door-2.png', alt: 'Lavna LH550 on modern brown door', class: 'lh-energy__door-img', width: 550, height: 275 -%}
          </div>
        </div>

        <div class="lh-energy__door-col lh-energy__door-center">
          <div class="lh-energy__door-item lh-energy__door-item--3">
            {%- render 'lh550-image', image: s.door_3_image, fallback: 'lh550-door-3.png', alt: 'Lavna LH550 on paneled door', class: 'lh-energy__door-img', width: 550, height: 460 -%}
          </div>
          <div class="lh-energy__door-card">
            <h2 class="lh-energy__door-title">
              <span class="lh-line">LOOKS <span class="lh-highlight">BEAUTIFUL</span> ON</span>
              <span class="lh-line"><span class="lh-highlight">EVERY DOOR</span> DESIGN</span>
            </h2>
          </div>
        </div>

        <div class="lh-energy__door-col lh-energy__door-col--right">
          <div class="lh-energy__door-item lh-energy__door-item--4">
            {%- render 'lh550-image', image: s.door_4_image, fallback: 'lh550-door-4.png', alt: 'Lavna LH550 with luxury bedroom view', class: 'lh-energy__door-img', width: 550, height: 311 -%}
          </div>
          <div class="lh-energy__door-item lh-energy__door-item--5">
            {%- render 'lh550-image', image: s.door_5_image, fallback: 'lh550-door-5.png', alt: 'Lavna LH550 interior view on wood grain door', class: 'lh-energy__door-img', width: 550, height: 328 -%}
          </div>
        </div>
      </div>
    </div>

    {% # Band 3 - software banner %}
    <div class="lh-energy__software">
      {%- render 'lh550-image', image: s.software_image, fallback: 'lh550-energy-software.png', alt: s.software_alt, class: 'lh-energy__software-img lh-energy__software-img--desktop', sizes: '(min-width: 900px) 1344px', width: 3000, height: 1500 -%}
      {%- render 'lh550-image', image: s.software_image_mobile, fallback: 'lh550-energy-software-mobile.png', alt: s.software_alt, class: 'lh-energy__software-img lh-energy__software-img--mobile', sizes: '(max-width: 899px) 94vw', width: 722, height: 1084 -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "LH550 energy",
  "tag": "div",
  "class": "lh550-energy-section",
  "settings": [
    {
      "type": "header",
      "content": "Energy saver (pro vs lite)"
    },
    {
      "type": "image_picker",
      "id": "compare_image",
      "label": "Pro vs lite banner",
      "info": "About 1342:358. Leave empty to use the pro-vs-lite banner from the design."
    },
    {
      "type": "text",
      "id": "compare_alt",
      "label": "Banner alt text",
      "default": "Hotel energy saver pro versus lite comparison"
    },
    {
      "type": "text",
      "id": "features_heading",
      "label": "Features label",
      "default": "KEY FEATURES"
    },
    {
      "type": "header",
      "content": "Door designs"
    },
    {
      "type": "textarea",
      "id": "beauty_heading",
      "label": "Heading",
      "default": "Looks BEAUTIFUL on\nevery door design"
    },
    {
      "type": "textarea",
      "id": "beauty_text",
      "label": "Supporting text (optional)"
    },
    {
      "type": "image_picker",
      "id": "beauty_image",
      "label": "Door photo",
      "info": "About 438:367. Leave empty to use the door photo from the design."
    },
    {
      "type": "text",
      "id": "beauty_alt",
      "label": "Door photo alt text",
      "default": "Luxury hotel door lock on a wooden door"
    },
    {
      "type": "header",
      "content": "Software banner"
    },
    {
      "type": "image_picker",
      "id": "software_image",
      "label": "Software banner",
      "info": "About 2:1. Leave empty to use the lock software banner from the design."
    },
    {
      "type": "text",
      "id": "software_alt",
      "label": "Software banner alt text",
      "default": "LAVNA hotel lock management software"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing (desktop)",
      "min": 0,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top spacing (mobile)",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caption",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Caption title (optional)"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile card image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Fallback image asset (e.g. lh550-esaver-pro.png)"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Caption text",
          "default": "Caption text"
        }
      ]
    },
    {
      "type": "shot",
      "name": "Detail photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo",
          "info": "Design export still pending; nothing shows until an image is picked."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Alt text",
          "default": "Energy saver detail photo"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH550 energy",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "A valid RFID or key card is inserted.\nPower consumption recorded in Software.\nBrief Power delay after card removal"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Any RFID Card can be inserted.\nSave Electricity when card not placed.\nInstant Power off after card removal"
          }
        },
        {
          "type": "shot"
        },
        {
          "type": "shot"
        },
        {
          "type": "shot"
        },
        {
          "type": "shot"
        }
      ]
    }
  ]
}
{% endschema %}
