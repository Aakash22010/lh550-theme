{%- comment -%}
  LH500 pricing table. Product blocks are the columns, feature blocks the rows.
  With no product picked the button shows the text prices and links to the URL.
{%- endcomment -%}
{% render 'lh500-assets' %}
{{ 'lh500-pricing.css' | asset_url | stylesheet_tag }}

{%- assign products = section.blocks | where: 'type', 'product' -%}
{%- assign features = section.blocks | where: 'type', 'feature' -%}
{%- assign row_count = features.size | plus: 2 -%}
<section class="lh lh-section lh-pricing{% if section.settings.button_full %} lh-pricing--btn-full{% endif %}" style="--pt:{{ section.settings.padding_top }};--ptm:{{ section.settings.padding_top_mobile }}">
  <div class="lh-container">
    {% # shorter heading on mobile if set %}
    <h2 class="lh-pricing__heading">
      {%- if section.settings.heading_mobile != blank -%}
        <span class="lh-pricing__heading-desktop">{{ section.settings.heading | escape }}</span>
        <span class="lh-pricing__heading-mobile">{{ section.settings.heading_mobile | escape }}</span>
      {%- else -%}
        {{ section.settings.heading | escape }}
      {%- endif -%}
    </h2>

    <div class="lh-pricing__panel">
      <div class="lh-pricing__grid" style="--n:{{ products.size }};grid-template-rows:repeat({{ row_count }}, auto)">
        {%- # card backgrounds %}
        {%- for col in products -%}
          <div class="lh-pricing__card lh-pricing__card--{{ forloop.index }}" style="grid-column:{{ forloop.index | plus: 1 }}" aria-hidden="true"></div>
        {%- endfor -%}

        {%- # strip behind the sticky label column %}
        <div class="lh-pricing__mask" style="grid-column:1;grid-row:1 / -1" aria-hidden="true"></div>

        {% # logo -%}
        <div class="lh-pricing__brand" style="grid-column:1;grid-row:1">
          {%- render 'lh500-image', image: section.settings.logo, fallback: 'lh500-pricing-logo.png', alt: '', class: 'lh-pricing__brand-img', sizes: '144px', width: 749, height: 713 -%}
        </div>

        {%- # product heads %}
        {%- for col in products -%}
          {%- liquid
            # live prices from the product, else the text settings
            assign p = col.settings.product
            if p != blank
              assign v = p.selected_or_first_available_variant
              # amounts without the currency symbol, the section adds its own prefix (Rs.)
              assign price_text = v.price | money_without_currency
              assign compare_text = v.compare_at_price | money_without_currency
              if col.settings.price_format == 'short'
                assign price_text = price_text | remove: '.00'
                assign compare_text = compare_text | remove: '.00'
              endif
              assign prefix = section.settings.price_prefix | escape
              assign price_text = prefix | append: price_text
              assign compare_text = prefix | append: compare_text
              # discount %, rounded the same way as lavnalocks.com
              assign discount_text = ''
              if v.compare_at_price > v.price
                assign pct = v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round
                assign discount_text = '-' | append: pct | append: '%'
              else
                assign compare_text = ''
              endif
            else
              assign price_text = col.settings.price | escape
              assign compare_text = col.settings.compare_price | escape
              assign discount_text = col.settings.discount | escape
            endif
          -%}
          <div class="lh-pricing__head" style="grid-column:{{ forloop.index | plus: 1 }};grid-row:1" {{ col.shopify_attributes }}>
            <div class="lh-pricing__media">
              {%- render 'lh500-image', image: col.settings.image, fallback: col.settings.fallback, alt: col.settings.name, class: 'lh-pricing__img', sizes: '113px', width: 260, height: 418 -%}
            </div>
            <h3 class="lh-pricing__name">{{ col.settings.name | escape }}</h3>
            <div class="lh-pricing__prices">
              <p class="lh-pricing__price">
                {%- if discount_text != blank -%}<span class="lh-pricing__discount">{{ discount_text }}</span> {% endif -%}
                <span class="lh-pricing__amount">{{ price_text }}</span>
              </p>
              <div class="lh-pricing__meta">
                {%- if compare_text != blank -%}
                  <s class="lh-pricing__compare"><span class="lh-visually-hidden">Regular price </span>{{ compare_text }}</s>
                {%- endif -%}
                {%- if col.settings.rating > 0 -%}
                  {%- render 'lh500-stars', rating: col.settings.rating, class: 'lh-pricing__stars' -%}
                {%- endif -%}
              </div>
            </div>
            {%- # cart icon on mobile, plain link when no product is picked %}
            {%- if col.settings.button_label != blank -%}
              {%- capture col_btn -%}
                <span class="lh-pricing__btn-label">{{ col.settings.button_label | escape }}</span>
                <svg class="lh-pricing__btn-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M2.5 3.5h2.6l2.4 11.2a1.6 1.6 0 0 0 1.6 1.3h8.6a1.6 1.6 0 0 0 1.5-1.2l1.7-7H6.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="9.5" cy="20" r="1.6" fill="currentColor"/><circle cx="17.5" cy="20" r="1.6" fill="currentColor"/></svg>
              {%- endcapture -%}
              {%- capture col_label -%}{{ col.settings.button_label }}: {{ col.settings.name }}{%- endcapture -%}
              {%- if p != blank and col.settings.button_action != 'link' -%}
                {%- render 'lh500-buy-button', product: p, action: col.settings.button_action, class: 'lh-btn lh-btn--primary lh-btn--sweep lh-pricing__btn', content: col_btn, aria_label: col_label, sold_out_label: col.settings.sold_out_label -%}
              {%- else -%}
                <a class="lh-btn lh-btn--primary lh-btn--sweep lh-pricing__btn" href="{{ col.settings.button_link | default: p.url | default: '#' }}" aria-label="{{ col_label | escape }}">{{ col_btn }}</a>
              {%- endif -%}
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- # feature rows -%}
        {%- if section.settings.features_title != blank -%}
          <p class="lh-pricing__features-title" style="grid-column:1;grid-row:2">{{ section.settings.features_title | escape }}</p>
        {%- endif -%}

        {%- for feature in features -%}
          {%- assign row = forloop.index | plus: 2 -%}
          {%- capture row_class -%}lh-pricing__cell{% if forloop.first %} is-first{% endif %}{% if forloop.last %} is-last{% endif %}{%- endcapture -%}
          <div class="{{ row_class }} lh-pricing__label" style="grid-column:1;grid-row:{{ row }}" {{ feature.shopify_attributes }}>
            {%- if feature.settings.label_mobile != blank -%}
              <span class="lh-pricing__d">{{ feature.settings.label | escape }}</span><span class="lh-pricing__m">{{ feature.settings.label_mobile | escape | newline_to_br }}</span>
            {%- else -%}
              {{ feature.settings.label | escape }}
            {%- endif -%}
          </div>
          {%- for col in products -%}
            {%- liquid
              # value_1..4 = columns 1..4, the _mobile versions are used on mobile when set
              case forloop.index
                when 1
                  assign v = feature.settings.value_1
                  assign vm = feature.settings.value_1_mobile
                when 2
                  assign v = feature.settings.value_2
                  assign vm = feature.settings.value_2_mobile
                when 3
                  assign v = feature.settings.value_3
                  assign vm = feature.settings.value_3_mobile
                else
                  assign v = feature.settings.value_4
                  assign vm = feature.settings.value_4_mobile
              endcase
            -%}
            {%- assign v_key = v | strip | downcase -%}
            <div class="{{ row_class }} lh-pricing__value" style="grid-column:{{ forloop.index | plus: 1 }};grid-row:{{ row }}">
              {%- # yes / no show a tick / cross %}
              {%- if v_key == 'yes' -%}
                <svg class="lh-pricing__mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#3aa935"/><path d="M6.8 12.4l3.4 3.3 7-7.2" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span class="lh-visually-hidden">Yes</span>
              {%- elsif v_key == 'no' -%}
                <svg class="lh-pricing__mark" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="12" fill="#d4202a"/><path d="M8.2 8.2l7.6 7.6M15.8 8.2l-7.6 7.6" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round"/></svg>
                <span class="lh-visually-hidden">No</span>
              {%- elsif vm != blank -%}
                <span class="lh-pricing__d">{{ v | escape }}</span><span class="lh-pricing__m">{{ vm | escape | newline_to_br }}</span>
              {%- else -%}
                {{ v | escape }}
              {%- endif -%}
            </div>
          {%- endfor -%}
          {%- unless forloop.last -%}
            <span class="lh-pricing__rule" style="grid-row:{{ row }}" aria-hidden="true"></span>
          {%- endunless -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "LH500 pricing",
  "class": "lh500-pricing-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Feature & Pricing" },
    { "type": "text", "id": "heading_mobile", "label": "Heading on mobile", "default": "Product Plans & Pricing", "info": "Leave empty to use the heading above." },
    { "type": "image_picker", "id": "logo", "label": "Brand mark", "info": "Leave empty to use the LAVNA house mark." },
    { "type": "text", "id": "features_title", "label": "Features title", "default": "FEATURES" },
    { "type": "text", "id": "price_prefix", "label": "Price prefix", "default": "Rs. ", "info": "Shown before live product prices, e.g. Rs. 3,990.00" },
    { "type": "checkbox", "id": "button_full", "label": "Full-width Add to Cart buttons", "default": false },
    { "type": "range", "id": "padding_top", "label": "Space above (desktop, px)", "min": 0, "max": 200, "step": 2, "default": 78 },
    { "type": "range", "id": "padding_top_mobile", "label": "Space above (mobile, px)", "min": 0, "max": 120, "step": 2, "default": 48 }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product column",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product", "info": "The button adds this product, and its price, compare-at price, discount % and stock are shown live. While empty, the texts below are used." },
        { "type": "select", "id": "button_action", "label": "When the button is clicked", "options": [
          { "value": "add", "label": "Add to cart (stay on the page)" },
          { "value": "buy", "label": "Buy now (go to checkout)" },
          { "value": "link", "label": "Open the button link" }
        ], "default": "add" },
        { "type": "select", "id": "price_format", "label": "Price format", "options": [
          { "value": "money", "label": "Store format (3,990.00)" },
          { "value": "short", "label": "Without decimals (3,990)" }
        ], "default": "money" },
        { "type": "text", "id": "sold_out_label", "label": "Sold out label", "default": "Sold out" },
        { "type": "text", "id": "name", "label": "Name", "default": "LH400" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "fallback", "label": "Bundled image (used when no image is picked)", "default": "lh500-price-lh500.png" },
        { "type": "text", "id": "discount", "label": "Discount label (when no product is selected)", "default": "-53%" },
        { "type": "text", "id": "price", "label": "Price (when no product is selected)", "default": "Rs. 3,990.00" },
        { "type": "text", "id": "compare_price", "label": "Compare-at price (when no product is selected)", "default": "Rs. 8,500.00" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 0, "max": 5, "step": 0.5, "default": 4.5 },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to Cart" },
        { "type": "url", "id": "button_link", "label": "Button link (when no product is selected, or 'Open the button link')" }
      ]
    },
    {
      "type": "feature",
      "name": "Feature row",
      "settings": [
        { "type": "text", "id": "label", "label": "Feature", "default": "Feature" },
        { "type": "textarea", "id": "label_mobile", "label": "Feature on mobile (optional)" },
        { "type": "text", "id": "value_1", "label": "Product 1 value", "default": "-", "info": "Type yes or no to show a tick or a cross. Same for the values below." },
        { "type": "textarea", "id": "value_1_mobile", "label": "Product 1 value on mobile (optional)" },
        { "type": "text", "id": "value_2", "label": "Product 2 value", "default": "-" },
        { "type": "textarea", "id": "value_2_mobile", "label": "Product 2 value on mobile (optional)" },
        { "type": "text", "id": "value_3", "label": "Product 3 value", "info": "Only shown when there is a third product column." },
        { "type": "textarea", "id": "value_3_mobile", "label": "Product 3 value on mobile (optional)" },
        { "type": "text", "id": "value_4", "label": "Product 4 value", "info": "Only shown when there is a fourth product column." },
        { "type": "textarea", "id": "value_4_mobile", "label": "Product 4 value on mobile (optional)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "LH500 pricing",
      "blocks": [
        { "type": "product", "settings": { "name": "LH400", "fallback": "lh500-price-lh400.png", "discount": "-53%", "price": "Rs. 3,990.00", "compare_price": "Rs. 8,500.00", "rating": 4.5, "button_label": "Add to Cart" } },
        { "type": "product", "settings": { "name": "LH500", "fallback": "lh500-price-lh500.png", "discount": "-60%", "price": "Rs. 5,185.00", "compare_price": "Rs. 12,990.00", "rating": 4.5, "button_label": "Add to Cart" } },
        { "type": "product", "settings": { "name": "LH510", "fallback": "lh500-price-lh510.png", "discount": "-60%", "price": "Rs. 5,200.00", "compare_price": "Rs. 12,990.00", "rating": 4.5, "button_label": "Add to Cart" } },
        { "type": "product", "settings": { "name": "LH550", "fallback": "lh500-price-lh550.png", "discount": "-58%", "price": "Rs. 5,450.00", "compare_price": "Rs. 12,990.00", "rating": 4.5, "button_label": "Add to Cart" } },
        { "type": "feature", "settings": { "label": "Color", "value_1": "Black", "value_2": "Matte Silver", "value_3": "Gold Black", "value_4": "Black Gold" } },
        { "type": "feature", "settings": { "label": "Manual Key", "label_mobile": "Manual \nKey", "value_1": "Yes, 2 Mechanical Keys", "value_1_mobile": "Yes, 2 Manual Keys", "value_2": "Yes, 2 Mechanical Keys", "value_2_mobile": "Yes, 2 Manual Keys", "value_3": "Yes, 2 Mechanical Keys", "value_3_mobile": "Yes, 2 Manual Keys", "value_4": "Yes, 2 Mechanical Keys", "value_4_mobile": "Yes, 2 Manual Keys" } },
        { "type": "feature", "settings": { "label": "RFID Card", "label_mobile": "RFID \nCard", "value_1": "Yes, 2 Cards", "value_2": "Yes, 2 Cards", "value_3": "Yes, 2 Cards", "value_4": "Yes, 2 Cards" } },
        { "type": "feature", "settings": { "label": "Battery Type", "label_mobile": "Battery \nType", "value_1": "4 Pcs * AA Alkaline", "value_2": "4 Pcs * AA Alkaline", "value_3": "4 Pcs * AA Alkaline", "value_4": "4 Pcs * AA Alkaline" } },
        { "type": "feature", "settings": { "label": "Door Thickness", "label_mobile": "Door \nThickness", "value_1": "30 - 65mm", "value_2": "30 - 65mm", "value_3": "30 - 65mm", "value_4": "30 - 65mm" } },
        { "type": "feature", "settings": { "label": "Security Alert", "label_mobile": "Alert", "value_1": "Room not Locked feature", "value_1_mobile": "Room not Locked", "value_2": "Room Locked feature", "value_2_mobile": "Room Locked", "value_3": "Room not Locked feature", "value_3_mobile": "Room not Locked", "value_4": "Room Locked feature", "value_4_mobile": "Room Locked" } },
        { "type": "feature", "settings": { "label": "Warranty", "value_1": "1 Year", "value_2": "3 Year", "value_3": "3 Year", "value_4": "3 Year" } },
        { "type": "feature", "settings": { "label": "Material used", "value_1": "Zinc alloy, ABS and Stainless steel", "value_2": "Zinc alloy, ABS and Stainless steel", "value_3": "Zinc alloy, ABS and Stainless steel", "value_4": "Zinc alloy, ABS and Stainless steel" } }
      ]
    }
  ]
}
{% endschema %}
